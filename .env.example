# ── Mode ─────────────────────────────────────────────────
# True  = demo (fake logs, for testing)
# False = real EC2 logs
DEMO_MODE=False

# ── Your 3 application log paths on EC2 ──────────────────
FOOD_APP_LOG=/var/log/food-app/app.log
SERVICENOW_LOG=/var/log/servicenow-monitor/app.log
CONFLUENCE_LOG=/var/log/confluence-chatbot/app.log

# ── Thresholds ────────────────────────────────────────────
CPU_THRESHOLD=80.0
RAM_THRESHOLD=85.0
DISK_THRESHOLD=90.0

# ── Model ─────────────────────────────────────────────────
WINDOW_SIZE=10
CORR_TIME_WINDOW=60
BURST_THRESHOLD=3
INCIDENT_DB=incidents.db
